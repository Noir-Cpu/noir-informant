# Cloudflare Workers static assets headers: https://developers.cloudflare.com/workers/static-assets/headers/
# vite preview applies the same rules (headers-preview.ts) so the e2e suite runs under this CSP.
# Everything is self-hosted (fonts, script, CSS, JSON), so the policy has no external origins.
# JSON-LD in index.html is a data block, not executable script, so it needs no hash.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Hashed filenames: safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Rewritten every six hours by the collector; keep it fresh but let repeat visits revalidate cheaply.
/data/*
  Cache-Control: public, max-age=300, must-revalidate
